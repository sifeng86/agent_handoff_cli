{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict secret control public result",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "status",
    "operation_id",
    "published_revision",
    "code_publication",
    "ownership",
    "secrets_shared",
    "decision",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "command": {
      "enum": [
        "secrets",
        "secrets configure",
        "secrets inspect",
        "secrets verify",
        "secrets reconcile",
        "secrets apply",
        "secrets resolve",
        "secrets decision apply"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "not_ready",
        "decision_required",
        "rejected",
        "unknown",
        "invalid",
        "unsupported"
      ]
    },
    "operation_id": {
      "type": "null"
    },
    "published_revision": {
      "type": "null"
    },
    "code_publication": {
      "const": "not_attempted"
    },
    "ownership": {
      "const": "unknown"
    },
    "secrets_shared": {
      "enum": [
        true,
        false,
        "partial",
        "unknown",
        null
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "decision.schema.json"
        }
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "secret_operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "preservation_handle": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "verified_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "updated_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "approved_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "shared_available_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "local_converged": {
      "type": "boolean"
    },
    "baseline_retained": {
      "type": "boolean"
    },
    "local_work_available": {
      "type": "boolean"
    },
    "secrets_mode": {
      "enum": [
        "local-env",
        "doppler"
      ]
    },
    "destination_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shared_read": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "shared_read_failure": {
      "enum": [
        "authentication_required",
        "unavailable"
      ]
    },
    "convergence": {
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "available_keys",
        "required_missing",
        "unsupported_keys",
        "secrets_shared"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "not_ready"
          ]
        },
        "available_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "required_missing": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "unsupported_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "secrets_shared": {
          "const": false
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "category"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "category": {
            "enum": [
              "secret_conflict",
              "secret_deletion",
              "scope_grant_required"
            ]
          }
        }
      }
    },
    "secret_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "upload_keys",
        "download_keys",
        "conflicts"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "decision_required"
          ]
        },
        "upload_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "download_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "category"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "category": {
                "enum": [
                  "secret_conflict",
                  "secret_deletion",
                  "scope_grant_required"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "conflicts": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "conflicts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {
            "not": {
              "const": "completed"
            }
          },
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {},
          "decision": {
            "type": "null"
          },
          "next_action": {}
        },
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets configure"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {
            "enum": [
              null,
              false
            ]
          },
          "decision": {},
          "next_action": {},
          "secrets_mode": {},
          "approved_keys": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "type": "object"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": "decision_required"
                },
                "decision": {
                  "properties": {
                    "category": {
                      "enum": [
                        "authority_binding"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets inspect"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {
            "enum": [
              null,
              false
            ]
          },
          "decision": {
            "type": "null"
          },
          "next_action": {},
          "availability": {},
          "secrets_mode": {},
          "destination_identity": {},
          "shared_read": {},
          "shared_read_failure": {},
          "local_work_available": {},
          "shared_available_keys": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "required": [
                "availability",
                "secrets_mode",
                "destination_identity"
              ],
              "properties": {
                "availability": {
                  "properties": {
                    "status": {
                      "const": "completed"
                    },
                    "required_missing": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "shared_read_failure"
              ]
            },
            "then": {
              "required": [
                "secrets_mode",
                "shared_read",
                "secrets_shared"
              ],
              "properties": {
                "secrets_mode": {
                  "const": "doppler"
                },
                "shared_read": {
                  "const": "unavailable"
                },
                "secrets_shared": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets verify"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {},
          "decision": {
            "type": "null"
          },
          "next_action": {},
          "availability": {},
          "secrets_mode": {},
          "destination_identity": {},
          "shared_read": {},
          "shared_read_failure": {},
          "local_work_available": {},
          "shared_available_keys": {},
          "convergence": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "required": [
                "availability",
                "secrets_mode",
                "destination_identity"
              ],
              "properties": {
                "availability": {
                  "properties": {
                    "status": {
                      "const": "completed"
                    },
                    "required_missing": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "secrets_shared": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "convergence"
              ],
              "properties": {
                "convergence": {
                  "const": "verified"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "shared_read_failure"
              ]
            },
            "then": {
              "required": [
                "secrets_mode",
                "shared_read",
                "secrets_shared"
              ],
              "properties": {
                "secrets_mode": {
                  "const": "doppler"
                },
                "shared_read": {
                  "const": "unavailable"
                },
                "secrets_shared": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets reconcile"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {
            "enum": [
              null,
              false
            ]
          },
          "decision": {},
          "next_action": {},
          "plan_id": {},
          "secret_plan": {},
          "conflicts": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "type": "object"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": "decision_required"
                },
                "decision": {
                  "properties": {
                    "category": {
                      "enum": [
                        "secret_conflict",
                        "secret_deletion"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets apply"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {},
          "decision": {
            "type": "null"
          },
          "next_action": {},
          "secret_operation_id": {},
          "verified_keys": {},
          "updated_keys": {},
          "preservation_handle": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "secret_operation_id"
                  ]
                },
                {
                  "required": [
                    "updated_keys"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets resolve"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {},
          "decision": {
            "type": "null"
          },
          "next_action": {},
          "secret_operation_id": {},
          "verified_keys": {},
          "local_converged": {},
          "baseline_retained": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "secret_operation_id"
                  ]
                },
                {
                  "required": [
                    "updated_keys"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "secrets decision apply"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {},
          "command": {},
          "status": {},
          "operation_id": {},
          "published_revision": {},
          "code_publication": {},
          "ownership": {},
          "secrets_shared": {
            "enum": [
              null,
              false
            ]
          },
          "decision": {
            "type": "null"
          },
          "next_action": {}
        },
        "additionalProperties": false
      }
    }
  ],
  "additionalProperties": false,
  "$comment": "Key names/state/opaque IDs only, never secret values or hashes. Runtime validates nested plan/availability/decision scope and protects final serialization after side effects."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private scoped secret reconciliation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "evidence",
    "target",
    "conflicts",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "evidence": {
      "$ref": "secret-journal.schema.json#/$defs/sharedSources"
    },
    "target": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "enum": [
          "secret_conflict",
          "secret_deletion",
          "scope_grant_required"
        ]
      }
    },
    "status": {
      "enum": [
        "pending",
        "applied",
        "aborted",
        "stale"
      ]
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "decision_id"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "applied"
          },
          "conflicts": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "$comment": "Runtime additionally verifies filename identity, approved key scope and exact target/conflicts recomputed from original B/L/R; stored decision-derived plans are terminal only."
}

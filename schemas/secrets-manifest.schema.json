{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nonsecret secrets manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "keys": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": false,
      "patternProperties": {
        "^DOPPLER_": {
          "properties": {
            "classification": {
              "const": "local-only"
            }
          }
        },
        "^": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "required"
          ],
          "properties": {
            "classification": {
              "enum": [
                "shared",
                "local-only",
                "file-backed"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "file": {
              "type": "string",
              "pattern": "^[^/\\\\:\\x00-\\x1f\\x7f]+(?:/[^/\\\\:\\x00-\\x1f\\x7f]+)*$",
              "not": {
                "pattern": "(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT]|\\.[aA][gG][eE][nN][tT]|\\.[eE][nN][vV])(?:/|$)"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "classification": {
                    "const": "file-backed"
                  }
                }
              },
              "then": {
                "required": [
                  "file"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "file"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}

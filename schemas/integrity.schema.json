{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private trusted authority baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_identity",
    "last_trusted_oid"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "last_trusted_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}

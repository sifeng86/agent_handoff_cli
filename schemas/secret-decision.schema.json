{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private secret decision intent",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_id",
        "kind",
        "candidate",
        "previous_binding"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "const": "binding"
        },
        "candidate": {
          "$ref": "secret-binding.schema.json"
        },
        "previous_binding": {
          "anyOf": [
            {
              "$ref": "secret-binding.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_id",
        "kind",
        "plan_id"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "const": "reconcile"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    }
  ],
  "$comment": "Runtime also verifies filename and public decision identity/category/repository; binding candidates remain bound to reviewed public approval details during execution."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private decision lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "checkout_identity",
    "context_identity"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "enum": [
        "pending",
        "applied",
        "aborted",
        "stale"
      ]
    },
    "checkout_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

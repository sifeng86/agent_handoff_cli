{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Private caller authority selection",
  "required": [
    "schema_version",
    "checkout_identity",
    "context_identity",
    "repository_identity",
    "transition_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "checkout_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transition_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}

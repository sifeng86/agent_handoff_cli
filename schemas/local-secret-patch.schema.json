{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensitive local dotenv and PEM patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected",
    "changes",
    "approved_deletions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "expected": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "changes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "approved_deletions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "expected_files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "file_changes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "$comment": "Runtime verifies approved classifications, paired file scope, exact observations, PEM framing and explicit deletion approval. File values are material; dotenv paths come only from the approved manifest.",
  "dependentRequired": {
    "expected_files": [
      "file_changes"
    ],
    "file_changes": [
      "expected_files"
    ]
  }
}

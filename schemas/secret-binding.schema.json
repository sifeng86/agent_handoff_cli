{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private approved secret binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_identity",
    "destination_identity",
    "mode",
    "project",
    "config",
    "manifest",
    "upload_authorized"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "destination_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "local-env",
        "doppler"
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "config": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "manifest": {
      "$ref": "secrets-manifest.schema.json"
    },
    "upload_authorized": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "local-env"
          }
        }
      },
      "then": {
        "properties": {
          "project": {
            "type": "null"
          },
          "config": {
            "type": "null"
          },
          "upload_authorized": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "project": {
            "type": "string"
          },
          "config": {
            "type": "string"
          }
        }
      }
    }
  ]
}

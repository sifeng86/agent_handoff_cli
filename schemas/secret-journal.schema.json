{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensitive private secret operation journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "phase",
    "evidence",
    "uploads",
    "downloads",
    "keys",
    "local_applied",
    "result"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "phase": {
      "enum": [
        "prepared",
        "sending",
        "applying_local",
        "resolved"
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/sharedEvidence"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local_patch"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "uploads": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "downloads": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "keys": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "status"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "status": {
            "enum": [
              "prepared",
              "sending",
              "verified",
              "rejected",
              "unknown"
            ]
          }
        }
      }
    },
    "local_applied": {
      "type": "boolean"
    },
    "result": {
      "enum": [
        "pending",
        "unknown",
        "local_only",
        "rejected",
        "verified",
        "partial"
      ]
    },
    "resolved_shared": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "partial"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "local_only",
              "rejected",
              "verified",
              "partial"
            ]
          },
          "keys": {
            "additionalProperties": {
              "properties": {
                "status": {
                  "enum": [
                    "prepared",
                    "verified",
                    "rejected"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "local_applied": {
            "const": false
          },
          "keys": {
            "additionalProperties": {
              "properties": {
                "status": {
                  "const": "prepared"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "local_applied": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "local_patch"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "binding",
              "session_id",
              "original_env",
              "target_env",
              "target_files",
              "original_files",
              "repository_identity",
              "context_identity",
              "checkout_identity"
            ],
            "properties": {
              "kind": {
                "const": "local_patch"
              },
              "binding": {
                "$ref": "secret-binding.schema.json"
              },
              "session_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "original_env": {
                "type": "string"
              },
              "target_env": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "target_files": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "original_files": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "repository_identity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "context_identity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "checkout_identity": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "uploads": {
            "maxProperties": 0
          },
          "downloads": {
            "maxProperties": 0
          },
          "resolved_shared": {
            "const": false
          },
          "result": {
            "enum": [
              "pending",
              "unknown",
              "local_only",
              "rejected",
              "partial"
            ]
          }
        }
      }
    }
  ],
  "$comment": "Nested evidence structural coverage remains incomplete; SecretService checks destination/caller/source evidence. Cross-key scope and ID uniqueness are runtime invariants.",
  "$defs": {
    "sharedEvidence": {
      "type": "object",
      "required": [
        "binding",
        "manifest",
        "local_raw",
        "observed_head",
        "repository_identity",
        "context_identity",
        "checkout_identity",
        "session_id",
        "plan_id",
        "decision_id",
        "local_values",
        "local",
        "remote",
        "target",
        "baseline"
      ],
      "additionalProperties": false,
      "properties": {
        "binding": {
          "allOf": [
            {
              "$ref": "secret-binding.schema.json"
            },
            {
              "properties": {
                "mode": {
                  "const": "doppler"
                }
              }
            }
          ]
        },
        "manifest": {
          "$ref": "secrets-manifest.schema.json"
        },
        "local_raw": {
          "type": "string"
        },
        "observed_head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "repository_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkout_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{32}$"
        },
        "local_values": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "local": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "remote": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "target": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "baseline": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sharedSources": {
      "type": "object",
      "required": [
        "binding",
        "manifest",
        "local_raw",
        "observed_head",
        "repository_identity",
        "context_identity",
        "checkout_identity",
        "session_id",
        "local_values",
        "local",
        "remote",
        "baseline"
      ],
      "additionalProperties": false,
      "properties": {
        "binding": {
          "allOf": [
            {
              "$ref": "secret-binding.schema.json"
            },
            {
              "properties": {
                "mode": {
                  "const": "doppler"
                }
              }
            }
          ]
        },
        "manifest": {
          "$ref": "secrets-manifest.schema.json"
        },
        "local_raw": {
          "type": "string"
        },
        "observed_head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "repository_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkout_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "local_values": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "local": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "remote": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "baseline": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}

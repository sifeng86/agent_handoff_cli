{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensitive private verified secret baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_identity",
    "config_identity",
    "shared_scope",
    "values",
    "verified_sync_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shared_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "verified_sync_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
